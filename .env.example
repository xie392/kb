# SQLite 数据库文件路径（相对项目根目录）
DATABASE_URL="file:./dev.db"

# Auth.js 会话密钥，生成方式：openssl rand -base64 32
AUTH_SECRET=""

# 生产环境设置为 true，允许信任反向代理转发
AUTH_TRUST_HOST="true"

# 后台入口路径（登录页同前缀），建议改成不易猜测的值（默认 kb-9f3x）
# 构建期注入，服务端与客户端统一读取；修改后需重新构建。
NEXT_PUBLIC_ADMIN_BASE_PATH="kb-9f3x"

# 附件保存目录（相对项目根目录，也支持绝对路径）
# 未配置时默认 public/uploads/attachments；通过 /api/attachments/file/<name> 访问。
ATTACHMENT_STORAGE_DIR="public/uploads/attachments"
