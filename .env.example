# ─────────────── 通用配置（本地/生产都需要）───────────────

# SQLite 数据库文件路径
# 本地开发：默认 file:./dev.db（项目根目录）
# Docker 生产：file:/data/dev.db（CI 自动写入，不要手动改）
DATABASE_URL="file:./dev.db"

# Auth.js 会话密钥，生成方式：openssl rand -base64 32
# 生产环境由 CI 首次部署自动生成，写入服务器 .env；本地开发自己生成一个填进来
AUTH_SECRET=""

# 生产环境设置为 true，允许信任反向代理（Caddy/Nginx）转发
AUTH_TRUST_HOST="false"

# ─────────────── 构建期注入（改了必须重新 build）───────────────

# 后台入口路径（登录页同前缀），建议改成不易猜测的值（默认 kb-9f3x）
# 决定登录页地址：https://域名/<这个值>/login
# 服务端与客户端统一读取；修改后需重新构建镜像
NEXT_PUBLIC_ADMIN_BASE_PATH="kb-9f3x"

# 站点对外 URL（SEO：canonical / OG / sitemap / robots 使用）
# 本地开发：http://localhost:3000
# 生产：必须改为公网域名，如 https://kb.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 站点显示名称的名字部分（如 XIE392），展示为 "XIE392的知识库"，"的知识库"为固定后缀
# 构建期注入，修改后需重新构建
NEXT_PUBLIC_SITE_NAME="XIE392"

# ─────────────── 附件存储 ───────────────

# 附件保存目录（相对项目根目录，也支持绝对路径）
# 未配置时默认 public/uploads/attachments；通过 /api/attachments/file/<name> 访问
# Docker 生产：/data/attachments（CI 自动写入，映射到宿主机 ./data/attachments）
ATTACHMENT_STORAGE_DIR="public/uploads/attachments"

# ─────────────── 数据备份 ───────────────

# 备份保存目录（相对项目根目录，也支持绝对路径）
# 未配置时默认 backups；Docker 生产建议指向持久化数据卷，如 /data/backups
# Docker 生产：/data/backups（CI 自动写入，映射到宿主机 ./data/backups）
BACKUP_DIR="backups"

# 备份最多保留份数，超出自动清理最旧备份（默认 30）
BACKUP_MAX_KEEP="30"

# ─────────────── AI 助手（DeepSeek）───────────────

# 编辑器 AI 助手（改写/续写/润色）使用 DeepSeek；仅服务端读取，不会下发前端
# 申请地址：https://platform.deepseek.com/
# 不配置时编辑器 AI 助手会提示"未配置"
DEEPSEEK_API_KEY=""

# ─────────────── 初始账号（仅首次部署生效）───────────────
# 以下三个变量仅在 users 表为空时（全新数据库第一次启动）由 seed 脚本使用
# 账号创建后再修改这三个值不会有任何效果；请在首次部署前定好
# 未设置时默认：admin / admin123 / 知识库管理员

# INIT_USERNAME="你的自定义用户名"
# INIT_PASSWORD="你的强密码"
# INIT_NICKNAME="显示昵称"

# ─────────────── Umami 访问统计（可选，构建期注入）───────────────
#
# ⚠️ 这三个是构建期变量：必须在「构建镜像」时注入（CI 通过 build-args 传入）。
#    写进服务器 .env 是无效的 —— Next 会在 `next build` 时把 NEXT_PUBLIC_*
#    内联进产物（静态壳 + CSP 一起固化在镜像里）。
#    本地开发可直接写在 .env.local（会自动参与构建）。

# Umami 实例根地址（自托管实例的对外域名），如 https://stats.example.com
NEXT_PUBLIC_UMAMI_URL=""

# Umami 网站 ID（Umami 后台创建网站后获取）
# 与上面的 URL 同时配置才会注入统计脚本；留空则不加载，CSP 也不会为其开例外
NEXT_PUBLIC_UMAMI_SITE_ID=""

# 限定只统计这些域名（逗号分隔，防止本地/预览环境误上报），如 xie392.cn,www.xie392.cn
NEXT_PUBLIC_UMAMI_DOMAINS=""

# ─────────────── CSP 灰度开关（可选，构建期注入）───────────────

# 设为 true 时 Content-Security-Policy 降级为 Content-Security-Policy-Report-Only
# （只上报不拦截），用于首次上线时观察是否存在违规，避免直接拦挂页面。
# 同属构建期变量：CI 读取 Repository Variable `CSP_REPORT_ONLY`。
# 确认无违规后删除本变量（或设为 false）并重新构建即可启用拦截。
CSP_REPORT_ONLY=""
