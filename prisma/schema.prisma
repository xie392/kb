generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String?
  createdAt    DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sort      Int        @default(0)
  createdAt DateTime   @default(now())
  articles  Article[]

  @@index([parentId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model Article {
  id         String             @id @default(cuid())
  title      String
  content    String // 富文本 HTML
  summary    String?
  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id])
  status     String             @default("normal") // normal | trash
  visibility String             @default("private") // private | public
  isPinned   Boolean            @default(false)
  viewCount  Int                @default(0)
  tags       ArticleTag[]
  dailyViews ArticleDailyView[]
  // 双向链接：outgoing = 本文引用了别人；incoming = 别人引用了本文（反向链接）
  outgoingLinks ArticleLink[] @relation("ArticleLinkSource")
  incomingLinks ArticleLink[] @relation("ArticleLinkTarget")
  // 历史版本快照（每次实质修改前保存上一版）
  revisions  ArticleRevision[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  // 列表/筛选/Feed/趋势的高频查询路径
  @@index([status, visibility, updatedAt])
  @@index([status, updatedAt])
  @@index([categoryId])
  @@index([isPinned])
  @@index([createdAt])
}

model ArticleDailyView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  count     Int      @default(0)

  @@unique([articleId, date])
  @@index([date])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  // 复合主键仅对 articleId 前缀高效，按标签反查需要单独索引
  @@index([tagId])
}

model Attachment {
  id        String   @id @default(cuid())
  name      String // 原始文件名（显示用）
  url       String // 存储相对路径，如 /uploads/attachments/xxx.jpg
  mimeType  String
  size      Int // 字节
  kind      String // image | file
  createdAt DateTime @default(now())

  @@index([kind])
  @@index([name])
}

/**
 * 双向链接关系：正文里写 [[笔记标题]] 时，由服务端解析并落库。
 * source 引用 target；同一对 (source, target) 只保留一条。
 */
model ArticleLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  source    Article  @relation("ArticleLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Article  @relation("ArticleLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

/**
 * 文章历史版本：每次「实质修改」（标题/正文/摘要变化）前保存上一版。
 * 每篇保留最近 N 版（见 article router 的裁剪逻辑）。
 */
model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String
  summary   String?
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}
